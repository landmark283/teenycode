BASE_URL=https://api.deepseek.com
API_KEY=sk-...
# Required: working directory the agent is allowed to read / edit / search / run commands in.
WORKSPACE=C:/path/to/your/project

# Optional: override the default model (gpt-5)
# MODEL=gpt-5

# Optional: max tool calls per conversation turn (default 64)
# MAX_TOOL_CALLING=64