BASE_URL=https://api.deepseek.com #openai format
API_KEY=sk-...
MODEL=deepseek-v4-flash # model name
MAX_TOOL_CALLING = 64   # 单次对话最多工具调用次数，实际上工具调用次数可能比这里设置的更多
WORKSPACE = D:\lg\else\agents大学习\agent-learning\source\teenycode
MAX_TOKENS = 24000      # 自动压缩上下文的触发位置
KEEP_TURNS = 3          # 压缩上下文时，保留不压缩的对话数

# web_search 工具（可选覆盖，默认走 BASE_URL 对应的 Anthropic 兼容端点）
# SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1   # 搜索端点（Anthropic 格式 Messages API）
# SEARCH_MODEL=deepseek-v4-flash                          # 搜索用的模型（默认同 MODEL）

# Optional: override the default model (gpt-5)
# MODEL=gpt-5

# Optional: max tool calls per conversation turn (default 64)
# MAX_TOOL_CALLING=64